{
  "name": "traffic.js",
  "version": "0.1.2",
  "description": "Process and visualise aircraft trajectories",
  "type": "module",
  "main": "dist/traffic.node.js",
  "module": "dist/traffic.js",
  "unpkg": "dist/traffic.min.js",
  "jsdeliver": "dist/traffic.min.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "clean": "rimraf build dist",
    "rebuild": "npm run clean && npm run build",
    "lint": "prettier -c ./src ./test",
    "format": "prettier -w ./src ./test",
    "postbuild": "tsc && cp data/scaler.onnx dist/scaler.onnx && cp data/classifier.onnx dist/classifier.onnx && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.mjs dist/ && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm dist/",
    "prepare": "prek install",
    "prepublishOnly": "npm run test & npm run lint & npm run build",
    "serve": "rollup -c --environment SERVE",
    "test": "node --loader ts-node/esm --experimental-specifier-resolution=node scripts/run-tests.mjs",
    "docs": "typedoc",
    "docs:serve": "typedoc && npx serve docs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xoolive/traffic.js"
  },
  "keywords": [
    "aviation"
  ],
  "author": "Xavier Olive",
  "license": "MIT",
  "dependencies": {
    "@turf/turf": "^7.3.4",
    "arquero": "^8.0.3",
    "d3": "^7.3.0",
    "fflate": "^0.7.3",
    "onnxruntime-web": "^1.24.3",
    "osmtogeojson": "^3.0.0-beta.5",
    "simplify-js": "^1.2.4",
    "thrust-wasm": "^0.2.2"
  },
  "devDependencies": {
    "@j178/prek": "^0.3.4",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/chai": "^4.3.0",
    "@types/chai-datetime": "^0.0.37",
    "@types/d3": "^7.1.0",
    "@types/mocha": "^9.1.0",
    "@types/node": "^15.6.1",
    "chai": "^6.2.2",
    "chai-datetime": "^1.8.0",
    "mocha": "^11.7.5",
    "prettier": "^2.6.1",
    "rimraf": "^6.1.3",
    "rollup": "^2.70.1",
    "rollup-plugin-bundle-size": "^1.0.3",
    "rollup-plugin-serve": "^1.1.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-node": "^10.7.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.4"
    }
  }
}
